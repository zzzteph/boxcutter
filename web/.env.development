# Loaded by `vite`/`npm run dev` only (development mode). The dev server runs on :5173 while the API runs on
# :8000, so point the SPA at the API explicitly. Production builds leave this unset and use same-origin
# (relative) requests, so the deployed SPA talks to whatever host served it — see web/src/api.js.
VITE_API_BASE=http://localhost:8000
